# Ignore binary files
out/
vcpkg/
*.bin

# Ignore compiled object files
.vs/
.vscode/
*.o
*.out
*.obj
*.d

# Ignore CMake system files
CMakeFiles
cmake_install.cmake

# Ignore Visual Studio configuration files
CMakeSettings.json
*.vcxproj
*.vcxproj.filters

# Ignore Visual Studio auto-save recovery folder
enc_temp_folder/

# Ignore CodeLite configuration files
*.workspace
*.workspace.*
compile_commands.json
*.session
*.tags

# Rust build output
rust/slirp/target/
target/

# Ignore generated executables
dingusppc
dingusppc.exe

# Ignore system files
.DS_Store
Thumb.db
ehthumbs.db

# IDE ignores
build
build*/
build-*
*.dir
*.user
DerivedData
*.xcodeproj/project.xcworkspace
*.xcodeproj/xcuserdata

# PowerMac Emulator build output and runtime state
PowerMacEmulator.exe
dingusppc.log
nvram.bin
pram.bin

# Never commit Apple ROM images or disk/ISO images
roms/
test-isos/
*.hda
*.iso
*.dmg

# Local VM state, configs and test assets
vms/
powermac.ini
emulator.ini
*.vhd
*.vmdk
*.qcow2
*.log
